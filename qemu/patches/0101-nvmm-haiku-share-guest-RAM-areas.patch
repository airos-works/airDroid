+/*
+ * airDroid: nvmm_hva_map() replaces a RAM block's host mapping with an NVMM
+ * VM object, so a file-backed memory backend cannot share guest RAM with
+ * another process. Instead the RAM areas are made cloneable and, when
+ * QEMU_NVMM_MAP_FILE names a file, every guest-physical RAM section is
+ * appended to it as "map <gpa> <size> <area> <offset>" (hex; area is the
+ * area id, offset the section's start within it) or "unmap <gpa> <size>",
+ * so a cooperating process can clone_area() the guest's memory.
+ */
+static void
+nvmm_haiku_log_mapping(hwaddr start_pa, ram_addr_t size, uintptr_t hva,
+    bool add)
+{
+    const char *path = getenv("QEMU_NVMM_MAP_FILE");
+    area_info info;
+    area_id area;
+    FILE *f;
+
+    if (path == NULL || *path == '\0') {
+        return;
+    }
+    f = fopen(path, "a");
+    if (f == NULL) {
+        return;
+    }
+    if (add) {
+        area = area_for((void *)hva);
+        if (area >= 0 && get_area_info(area, &info) == B_OK) {
+            fprintf(f, "map %" PRIx64 " %" PRIx64 " %" PRIx32 " %" PRIx64 "\n",
+                (uint64_t)start_pa, (uint64_t)size, (uint32_t)area,
+                (uint64_t)(hva - (uintptr_t)info.address));
+        }
+    } else {
+        fprintf(f, "unmap %" PRIx64 " %" PRIx64 "\n", (uint64_t)start_pa,
+            (uint64_t)size);
+    }
+    fclose(f);
+}
+#endif
 
