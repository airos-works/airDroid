+int
+virgl_resource_get_shadow_fd(struct virgl_resource *res, uint64_t *out_size)
+{
+   if (!res->shadow_ptr) {
+      if (!res->pipe_resource)
+         return -1;
+
+      struct vrend_renderer_resource_info info;
+      vrend_renderer_resource_get_info(res->pipe_resource, &info);
+      if (!info.width || !info.height || info.depth > 1 || info.stride < info.width ||
+          info.stride % info.width)
+         return -1;
+
+      /* rows spaced as the device wants them (vkr_dispatch_vkCreateImage
+       * gives the image on it the same pitch)
+       */
+      const uint32_t stride = (info.stride + VIRGL_SHADOW_PITCH_ALIGN - 1) /
+                              VIRGL_SHADOW_PITCH_ALIGN * VIRGL_SHADOW_PITCH_ALIGN;
+      const uint64_t size = (uint64_t)stride * info.height;
+      void *ptr = NULL;
+      const int fd = virgl_shm_create(size, "virgl shadow", &ptr);
+      if (fd < 0)
+         return -1;
+
+      /* what the resource holds now (what GL drew or the guest uploaded) */
+      struct pipe_box box = { .width = info.width, .height = info.height, .depth = 1 };
+      struct iovec iov = { .iov_base = ptr, .iov_len = size };
+      const struct vrend_transfer_info transfer_info = {
+         .stride = stride,
+         .box = &box,
+         .iovec = &iov,
+         .iovec_cnt = 1,
+      };
+      if (vrend_renderer_transfer_pipe(res->pipe_resource, &transfer_info,
+                                       VIRGL_TRANSFER_FROM_HOST))
+         memset(ptr, 0, size);
+
+      res->shadow_ptr = ptr;
+      res->shadow_size = size;
+      res->shadow_stride = stride;
+      res->shadow_bpp = info.stride / info.width;
+      res->shadow_fd = fd;
+   }
+
+   *out_size = virgl_shm_size(res->shadow_fd);
+   return os_dupfd_cloexec(res->shadow_fd);
+}
+
+/* A read of a resource that has a shadow: the rows are there already. */
+static int
+virgl_resource_shadow_read(struct virgl_resource *res, uint32_t stride,
+                           const struct virgl_box *box, uint64_t offset,
+                           const struct iovec *iovec, int iovec_cnt)
+{
+   const uint32_t bpp = res->shadow_bpp;
+   const uint64_t row = (uint64_t)box->w * bpp;
+   if (!stride)
+      stride = res->shadow_stride;
+
+   if (!box->w || !box->h || (uint64_t)box->x * bpp + row > res->shadow_stride ||
+       ((uint64_t)box->y + box->h) * res->shadow_stride > res->shadow_size || stride < row)
+      return EINVAL;
+
+   if (!iovec || !iovec_cnt) {
+      iovec = res->iov;
+      iovec_cnt = res->iov_count;
+      if (!iovec)
+         return EINVAL;
+   }
+
+   const uint8_t *src = (const uint8_t *)res->shadow_ptr +
+                        (uint64_t)box->y * res->shadow_stride + (uint64_t)box->x * bpp;
+   if (iovec_cnt == 1 && stride == res->shadow_stride && row == stride) {
+      /* whole rows into one piece: one copy */
+      const uint64_t len = (uint64_t)box->h * stride;
+      if (offset + len > iovec[0].iov_len)
+         return EINVAL;
+      memcpy((uint8_t *)iovec[0].iov_base + offset, src, len);
+      return 0;
+   }
+   for (uint32_t y = 0; y < box->h; y++) {
+      if (vrend_write_to_iovec(iovec, iovec_cnt, offset + (uint64_t)y * stride,
+                               (const char *)src + (uint64_t)y * res->shadow_stride,
+                               row) != row)
+         return EINVAL;
+   }
+   return 0;
+}
