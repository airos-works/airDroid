--- a/src/virgl_shm.h
+++ b/src/virgl_shm.h
@@ -0,0 +1,199 @@
+/*
+ * Copyright 2026 the airDroid project
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef VIRGL_SHM_H
+#define VIRGL_SHM_H
+
+/* Memory shared between the renderer's processes and the VMM, named by a
+ * file descriptor that is passed around.
+ *
+ * Elsewhere that is an anonymous file and mmap(). On Haiku (air/OS) shared
+ * memory files live on the boot volume (their pages get written to disk)
+ * and a guest can only be given memory that is locked (NVMM's
+ * nvmm_hva_map_existing()). So there the memory is a fully locked, cloneable
+ * area, and the descriptor is a small unlinked file that names it; mapping
+ * clones the area.
+ */
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include "util/anon_file.h"
+#include "util/macros.h"
+
+#ifdef __HAIKU__
+
+#include <OS.h>
+
+#define VIRGL_SHM_MAGIC UINT64_C(0x6d68734c47525641) /* "AVRGLshm" */
+
+struct virgl_shm_file {
+   uint64_t magic;
+   int64_t area;
+   uint64_t size;
+};
+
+/* Makes shared memory of size bytes (rounded up to pages), mapped at
+ * *out_ptr; the descriptor, or -1.
+ */
+static inline int
+virgl_shm_create(size_t size, const char *name, void **out_ptr)
+{
+   const size_t rounded = (size + B_PAGE_SIZE - 1) & ~(size_t)(B_PAGE_SIZE - 1);
+   void *addr = NULL;
+   const area_id area = create_area(name, &addr, B_ANY_ADDRESS, rounded, B_FULL_LOCK,
+                                    B_READ_AREA | B_WRITE_AREA | B_CLONEABLE_AREA);
+   if (area < 0) {
+      errno = ENOMEM;
+      return -1;
+   }
+
+   char path[] = "/tmp/virgl-shm-XXXXXX";
+   const int fd = mkstemp(path);
+   if (fd < 0) {
+      delete_area(area);
+      return -1;
+   }
+   unlink(path);
+   fcntl(fd, F_SETFD, FD_CLOEXEC);
+
+   const struct virgl_shm_file file = {
+      .magic = VIRGL_SHM_MAGIC,
+      .area = area,
+      .size = rounded,
+   };
+   if (write(fd, &file, sizeof(file)) != (ssize_t)sizeof(file)) {
+      close(fd);
+      delete_area(area);
+      return -1;
+   }
+
+   *out_ptr = addr;
+   return fd;
+}
+
+/* Maps what fd names (size bytes of it), for reading and writing;
+ * MAP_FAILED if that fails. A descriptor that is not one of ours is mapped
+ * as a file.
+ */
+static inline void *
+virgl_shm_map(int fd, size_t size)
+{
+   struct virgl_shm_file file;
+   if (pread(fd, &file, sizeof(file), 0) != (ssize_t)sizeof(file) ||
+       file.magic != VIRGL_SHM_MAGIC)
+      return mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+
+   if (size > file.size) {
+      errno = EINVAL;
+      return MAP_FAILED;
+   }
+
+   /* a clone of a fully locked area is fully locked too */
+   void *addr = NULL;
+   const area_id clone = clone_area("virgl shm", &addr, B_ANY_ADDRESS,
+                                    B_READ_AREA | B_WRITE_AREA | B_CLONEABLE_AREA,
+                                    (area_id)file.area);
+   if (clone < 0) {
+      errno = ENOMEM;
+      return MAP_FAILED;
+   }
+   return addr;
+}
+
+/* Another mapping of what virgl_shm_create() or virgl_shm_map() mapped at
+ * ptr, to be unmapped by itself; NULL if that fails. For memory a driver
+ * pins (a host pointer import): an area with pinned pages cannot be deleted
+ * until they are released (delete_area() waits, for good if the import
+ * outlives it), so the import gets a mapping of its own and the original
+ * can go whenever its owner is done with it.
+ */
+static inline void *
+virgl_shm_clone(void *ptr)
+{
+   const area_id area = area_for(ptr);
+   area_info info;
+   if (area < 0 || get_area_info(area, &info) != B_OK || info.address != ptr)
+      return NULL;
+
+   void *addr = NULL;
+   const area_id clone = clone_area("virgl shm import", &addr, B_ANY_ADDRESS,
+                                    B_READ_AREA | B_WRITE_AREA | B_CLONEABLE_AREA, area);
+   return clone < 0 ? NULL : addr;
+}
+
+/* How much memory fd names (a multiple of the page size here). */
+static inline uint64_t
+virgl_shm_size(int fd)
+{
+   struct virgl_shm_file file;
+   if (pread(fd, &file, sizeof(file), 0) == (ssize_t)sizeof(file) &&
+       file.magic == VIRGL_SHM_MAGIC)
+      return file.size;
+   return lseek(fd, 0, SEEK_END);
+}
+
+/* Unmaps what virgl_shm_create() or virgl_shm_map() mapped at ptr. */
+static inline int
+virgl_shm_unmap(void *ptr, size_t size)
+{
+   const area_id area = area_for(ptr);
+   area_info info;
+   if (area >= 0 && get_area_info(area, &info) == B_OK && info.address == ptr)
+      return delete_area(area) == B_OK ? 0 : -1;
+   return munmap(ptr, size);
+}
+
+#else /* !__HAIKU__ */
+
+static inline int
+virgl_shm_create(size_t size, const char *name, void **out_ptr)
+{
+   const int fd = os_create_anonymous_file(size, name);
+   if (fd < 0)
+      return -1;
+
+   void *ptr = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+   if (ptr == MAP_FAILED) {
+      close(fd);
+      return -1;
+   }
+
+   *out_ptr = ptr;
+   return fd;
+}
+
+static inline void *
+virgl_shm_map(int fd, size_t size)
+{
+   return mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+}
+
+static inline uint64_t
+virgl_shm_size(int fd)
+{
+   return lseek(fd, 0, SEEK_END);
+}
+
+static inline void *
+virgl_shm_clone(UNUSED void *ptr)
+{
+   /* only where memory is imported by host pointer */
+   return NULL;
+}
+
+static inline int
+virgl_shm_unmap(void *ptr, size_t size)
+{
+   return munmap(ptr, size);
+}
+
+#endif /* !__HAIKU__ */
+
+#endif /* VIRGL_SHM_H */
